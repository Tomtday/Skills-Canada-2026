    Brain.Screen.printAt(10, 258, "Segment %d / %d", seg, NUM_SEGMENTS);
  } else {
    Brain.Screen.printAt(10, 258, "Starting up...");
  }
}

void drawDoneScreen() {
  Brain.Screen.setFillColor(color(0, 100, 200));
  Brain.Screen.setPenColor(color(0, 100, 200));
  Brain.Screen.drawRectangle(0, 0, 480, 272);
  Drivetrain.drive(forward);

  Brain.Screen.setPenColor(white);
  Brain.Screen.setFont(fontType::prop60);
  Brain.Screen.printAt(480 / 2 - 85, 120, "DONE!");

  Brain.Screen.setFont(fontType::prop20);
  Brain.Screen.printAt(10, 258, "Autonomous complete.");
}

// ─────────────────────────────────────────────────────────────────────────────
// MAIN
// ─────────────────────────────────────────────────────────────────────────────
int main() {
  vexcodeInit();
  vex::task headingTask = vex::task(headingAveragerTask);
  loadDistances();
  selectFanPosition();
  drawReadyButton();
  while (true) {
    if (Brain.Screen.pressing()) {
      int tx = Brain.Screen.xPosition();
      int ty = Brain.Screen.yPosition();
      if (tx >= BTN_X && tx <= BTN_X + BTN_W &&
          ty >= BTN_Y && ty <= BTN_Y + BTN_H) {
        break; // button pressed — launch auton
      }
    }
    wait(20, msec);
  }

  // Switch to green running screen.
  drawRunningScreen(0);
  wait(300, msec); // brief visual confirmation before motors start

  runAuton();

  Drivetrain.stop();
  Intakes.stop();
  Conveyor.stop();
  Slides.stop();

  drawDoneScreen();

  while (true) {
    wait(100, msec);
  }
}
