// SEGMENT DATA
// ─────────────────────────────────────────────────────────────────────────────
#define NUM_SEGMENTS 15
#define SD_FILENAME "segdist.txt"

// Default distances, overwritten by SD card on startup
float segDist[NUM_SEGMENTS] = {
  5.0,   // Seg 1
  39.0,  // Seg 2
  6.0,   // Seg 3
  58.0,  // Seg 4
  30.0,  // Seg 5
  21.0,  // Seg 6
  12.0,  // Seg 7
  41.0,  // Seg 8
  13.0,  // Seg 9
  3.0,   // Seg 10
  16.0,  // Seg 11
  5.0,   // Seg 12
  33.0,  // Seg 13
  3.0,   // Seg 14
  5.0    // Seg 15
};

int slideDist = 550;
float seg6TurnDeg = 90.0f;
float distDiff1 = 8.0f;   // offset for fan position 1 (inches)
float distDiff3 = 8.0f;   // offset for fan position 3 (inches)
int   fanPos    = 2;       // selected fan position: 1, 2, or 3

// SD CARD — load distances
void loadDistances() {
  if (!Brain.SDcard.isInserted()) {
    Brain.Screen.clearScreen();
    Brain.Screen.setCursor(1, 1);
    Brain.Screen.print("WARNING: No SD card!");
    Brain.Screen.newLine();
    Brain.Screen.print("Using default values.");
    wait(2000, msec);
    return;
  }

  FILE* f = fopen(SD_FILENAME, "r");
  if (f == nullptr) {
    Brain.Screen.clearScreen();
    Brain.Screen.setCursor(1, 1);
    Brain.Screen.print("WARNING: segdist.txt");
    Brain.Screen.newLine();
    Brain.Screen.print("not found on SD card!");
    Brain.Screen.newLine();
    Brain.Screen.print("Using default values.");
    wait(2000, msec);
    return;
  }

  for (int i = 0; i < NUM_SEGMENTS; i++) {
    float val = 0.0f;
    if (fscanf(f, "%f", &val) == 1 && val >= 0.1f) {
      segDist[i] = val;
    }
  }
  float turnVal = 0.0f;
  if (fscanf(f, "%f", &turnVal) == 1 && turnVal >= 1.0f) {
    seg6TurnDeg = turnVal;
  }
  // Load distDiff1 and distDiff3
  float dd1 = 0.0f, dd3 = 0.0f;
  if (fscanf(f, "%f", &dd1) == 1 && dd1 >= 0.1f) distDiff1 = dd1;
  if (fscanf(f, "%f", &dd3) == 1 && dd3 >= 0.1f) distDiff3 = dd3;
  fclose(f);
}

// Average the two inertial sensors to compensate for sensor error
int headingAveragerTask() {
  while (true) {
    float h1 = DrivetrainInertial.heading(degrees);
    float h2 = DrivetrainInertial2.heading(degrees);
    float diff = h2 - h1;
    while (diff >  180.0f) diff -= 360.0f;
    while (diff <= -180.0f) diff += 360.0f;
    float avg = h1 + diff * 0.5f;
    if (avg <    0.0f) avg += 360.0f;
    if (avg >= 360.0f) avg -= 360.0f;
    Drivetrain.setHeading(avg, degrees);
    wait(10, msec);
  }
  return 0;
}

// AUTONOMOUS ROUTINE
void runAuton() {
  Intakes.setVelocity(15.0, percent);
  Conveyor.setVelocity(40.0, percent);
  Slides.setVelocity(20.0, percent);
  Conveyor.setPosition(0.0, degrees);
  Slides.setPosition(0.0, degrees);
  Intakes.setPosition(0.0, degrees);
  Slides.setTimeout(7.0, sec);
  Drivetrain.setDriveVelocity(50.0, percent);

  wait (15, seconds);

  // Segment 1
  Drivetrain.driveFor(forward, segDist[0], inches, true);
  Drivetrain.turnFor(left, 90.0, degrees, true);

  // Segment 2
  Drivetrain.driveFor(forward, segDist[1], inches, true);
  Drivetrain.turnFor(left, 90.0, degrees, true);

  // Segment 3
  // intake 1st supply 
  {
    Drivetrain.driveFor(forward, segDist[2], inches, false);
    double start = Brain.Timer.time(msec);
    bool nudgeDone = false;
    Intakes.spin(forward);
    while (!BumperA.pressing()) {
      if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {
        Drivetrain.driveFor(forward, 1, inches, false);
        nudgeDone = true;
      }
      if ((Brain.Timer.time(msec) - start) >= 5000) break;
    }
    Intakes.stop();
    Slides.spinFor(forward, slideDist, degrees, true);
    Intakes.spinFor(forward, 2.0, turns, false);
    Conveyor.spinFor(forward, 6.0, turns, false);
    wait(1.0, seconds);
    Drivetrain.turnFor(right, 180.0, degrees, true);
  }

  // Segment 4
  // drive to auton zone
  Drivetrain.driveFor(forward, segDist[3], inches, true);
  Drivetrain.turnFor(right, 90.0, degrees, true);

  // Segment 5
  // into auton zone, first turn
  Drivetrain.driveFor(forward, segDist[4], inches, true);
  Intakes.spinToPosition(0.0, degrees, false);
  Drivetrain.turnFor(right, 90.0, degrees, true);

  // Segment 6
  // main auton zone, turn to 2nd supply
  Drivetrain.driveFor(forward, segDist[5], inches, true);
  Drivetrain.turnFor(right, seg6TurnDeg, degrees, true);
  Slides.spinFor(reverse, slideDist, degrees, true);

  // Segment 7
  // intake 2nd supply
  {
    Drivetrain.driveFor(forward, segDist[6], inches, false);
    double start = Brain.Timer.time(msec);
    bool nudgeDone = false;
    Intakes.spin(forward);
    while (!BumperA.pressing()) {
      if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 5000) {
        Drivetrain.driveFor(forward, 2, inches, false);
        nudgeDone = true;
      }
      if ((Brain.Timer.time(msec) - start) >= 8000) break;
    }
    Intakes.stop();
    Slides.spinFor(forward, slideDist, degrees, true);
    Intakes.spinFor(forward, 2.0, turns, false);
    Conveyor.spinFor(forward, 6.0, turns, false);
    Drivetrain.turnToRotation(270, degrees, true);
  }

  // Segment 8
  // reverse to fan, turn
  {
    float seg8Rev = segDist[7];
    if      (fanPos == 1) seg8Rev -= distDiff1;
    else if (fanPos == 3) seg8Rev += distDiff3;
    Drivetrain.driveFor(reverse, seg8Rev, inches, true);
  }
  Slides.spinFor(reverse, slideDist, degrees, true);
  Drivetrain.turnFor(right, 90.0, degrees, true);

  // Segment 9
  // intake fan
  {
    Drivetrain.driveFor(forward, segDist[8], inches, true);
    double start = Brain.Timer.time(msec);
    bool nudgeDone = false;
    Intakes.spin(forward);
    while (!BumperA.pressing()) {
      if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {
        Drivetrain.driveFor(forward, 1, inches, false);
        nudgeDone = true;
      }
      if ((Brain.Timer.time(msec) - start) >= 5000) break;
    }
    Intakes.stop();
    Slides.spinFor(forward, 12.0, turns, true);
  }

  // Segment 10
  // reverse to platform, turn around
  Drivetrain.setDriveVelocity(30, percent);
  Drivetrain.setTurnVelocity(30, percent);
  if (fanPos == 2) {
    // Default/mid position: reverse then 180
    Drivetrain.driveFor(reverse, segDist[9], inches, true);
    Drivetrain.turnFor(right, 180.0, degrees, true);
  } else if (fanPos == 1) {
    // Position 1: turn 90 right, then drive forward by distDiff1
    Drivetrain.driveFor(reverse, segDist[9], inches, true);
    wait (100, msec);
    Drivetrain.turnFor(right, 90.0, degrees, true);
    wait (100, msec);
    Drivetrain.driveFor(forward, distDiff1, inches, true);
    wait (100, msec);
    Drivetrain.turnFor(right, 90.0, degrees, true);
  } else if (fanPos == 3) {
    // Position 3: turn 90 right, then reverse by distDiff3
    Drivetrain.driveFor(reverse, segDist[9], inches, true);
    wait (100, msec);
    Drivetrain.turnFor(right, 90.0, degrees, true);
    wait (100, msec);
    Drivetrain.driveFor(reverse, distDiff3, inches, true);
    wait (100, msec);
    Drivetrain.turnFor(right, 90.0, degrees, true);
  }

  // Segment 11
  // outtake fan
  Drivetrain.driveFor(forward, segDist[10], inches, true);
  Intakes.spinFor(reverse, 360.0, degrees, true);

  // Segment 12
  // reverse away after outtake
  Drivetrain.driveFor(reverse, segDist[11], inches, true);
  Drivetrain.turnFor(left, 90, degrees, true);
  Slides.spinFor(reverse, 12.0, turns, true);

  // Segment 13
  // go to 3rd supply
  Drivetrain.driveFor(forward, segDist[12], inches, true);
  Intakes.stop();

  // Segment 14
  // intake 3rd supply
  {
    Drivetrain.driveFor(forward, segDist[13], inches, false);
    double start = Brain.Timer.time(msec);
    bool nudgeDone = false;
    Intakes.spin(forward);
    while (!BumperA.pressing()) {
      if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {
        Drivetrain.driveFor(forward, 1, inches, false);
        nudgeDone = true;
      }
      if ((Brain.Timer.time(msec) - start) >= 5000) break;
    }
    Intakes.stop();
    Drivetrain.turnFor(left, 90.0, degrees, true);
  }

  // Segment 15
    Drivetrain.driveFor(forward, segDist[14], inches, true);
    Slides.spinToPosition(slideDist, degrees, true);
    Intakes.spinToPosition (60, degrees, true);
    Conveyor.spinFor(forward, 6.7, turns, true);
    Intakes.spinFor(reverse, 30, degrees, true);
    Intakes.spinToPosition(60, degrees, true);
    Conveyor.spinFor(reverse, 400, degrees, true);
    Intakes.spinFor(reverse, 30, degrees);
}

