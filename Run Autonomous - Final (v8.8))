void drawRunningScreen(int seg) {
  // Green background
  Brain.Screen.setFillColor(color(0, 160, 0));
  Brain.Screen.setPenColor(color(0, 160, 0));
  Brain.Screen.drawRectangle(0, 0, 480, 272);

  // Big green button area
  Brain.Screen.setFillColor(color(30, 200, 30));
  Brain.Screen.setPenColor(color(30, 200, 30));
  Brain.Screen.drawRectangle(BTN_X, BTN_Y, BTN_W, BTN_H);

  Brain.Screen.setPenColor(white);
  Brain.Screen.setFont(fontType::prop60);
  Brain.Screen.printAt(480 / 2 - 90, BTN_Y + 55, "AUTON");
  Brain.Screen.printAt(480 / 2 - 85, BTN_Y + 110, "RUNNING");

  // Status bar
  Brain.Screen.setFillColor(color(0, 80, 0));
  Brain.Screen.setPenColor(color(0, 80, 0));
  Brain.Screen.drawRectangle(0, 240, 480, 32);
  Brain.Screen.setPenColor(white);
  Brain.Screen.setFont(fontType::prop20);
