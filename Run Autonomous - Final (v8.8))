// Fan position selection
// Three large coloured buttons (1=red, 2=green, 3=blue) side by side.
// Blocks until the user taps one, then sets fanPos accordingly.
void selectFanPosition() {
  bool selected = false;
  while (!selected) {
    Brain.Screen.clearScreen();

    // Button 1 (red)
    Brain.Screen.setFillColor(color(120, 20, 20));
    Brain.Screen.setPenColor(color(120, 20, 20));
    Brain.Screen.drawRectangle(10, 20, 130, 180);
    Brain.Screen.setFillColor(color(210, 50, 50));
    Brain.Screen.setPenColor(color(210, 50, 50));
    Brain.Screen.drawRectangle(13, 23, 124, 174);
    Brain.Screen.setPenColor(white);
    Brain.Screen.setFont(fontType::mono40);
    Brain.Screen.printAt(52, 125, "1");

    // Button 2 (green)
    Brain.Screen.setFillColor(color(20, 110, 20));
    Brain.Screen.setPenColor(color(20, 110, 20));
    Brain.Screen.drawRectangle(175, 20, 130, 180);
    Brain.Screen.setFillColor(color(50, 190, 50));
    Brain.Screen.setPenColor(color(50, 190, 50));
    Brain.Screen.drawRectangle(178, 23, 124, 174);
    Brain.Screen.setPenColor(white);
    Brain.Screen.setFont(fontType::mono40);
    Brain.Screen.printAt(217, 125, "2");

    // Button 3 (blue)
    Brain.Screen.setFillColor(color(20, 20, 160));
    Brain.Screen.setPenColor(color(20, 20, 160));
    Brain.Screen.drawRectangle(340, 20, 130, 180);
    Brain.Screen.setFillColor(color(50, 50, 210));
    Brain.Screen.setPenColor(color(50, 50, 210));
    Brain.Screen.drawRectangle(343, 23, 124, 174);
    Brain.Screen.setPenColor(white);
    Brain.Screen.setFont(fontType::mono40);
    Brain.Screen.printAt(382, 125, "3");

    // Labels at bottom
    Brain.Screen.setFillColor(black);
    Brain.Screen.setPenColor(black);
    Brain.Screen.drawRectangle(0, 210, 480, 62);
    Brain.Screen.setPenColor(white);
    Brain.Screen.setFont(fontType::prop20);
    Brain.Screen.printAt(18,  232, "Fan Pos 1");
    Brain.Screen.printAt(183, 232, "Fan Pos 2");
    Brain.Screen.printAt(348, 232, "Fan Pos 3");
    Brain.Screen.printAt(130, 255, "Select fan location");

    wait(20, msec);

    if (Brain.Screen.pressing()) {
      int tx = Brain.Screen.xPosition();
      int ty = Brain.Screen.yPosition();

      int chosen = 0;
      if      (tx >= 10  && tx <= 140 && ty >= 20 && ty <= 200) chosen = 1;
      else if (tx >= 175 && tx <= 305 && ty >= 20 && ty <= 200) chosen = 2;
      else if (tx >= 340 && tx <= 470 && ty >= 20 && ty <= 200) chosen = 3;

      if (chosen > 0) {
        fanPos = chosen;
        selected = true;

        // Flash confirmation in the matching colour
        color flashCol = (chosen == 1) ? color(210, 50, 50)
                       : (chosen == 2) ? color(50, 190, 50)
                                       : color(50, 50, 210);
        Brain.Screen.clearScreen();
        Brain.Screen.setFillColor(flashCol);
        Brain.Screen.setPenColor(flashCol);
        Brain.Screen.drawRectangle(0, 0, 480, 272);
        Brain.Screen.setPenColor(white);
        Brain.Screen.setFont(fontType::prop60);
        Brain.Screen.printAt(110, 100, "Position %d", chosen);
        wait(700, msec);
        while (Brain.Screen.pressing()) wait(10, msec);
      }
    }
  }
}

