// Tuning loop:
/*
 Controls:
   UP = advance to next segment (wraps around)
   X = increase current segment distance by step
   B = decrease current segment distance by step (min 0.1 in)
   R1 = increase step size (0.5, 2.0, 5.0 in)
   R2 = decrease step size (5.0, 2.0, 0.5 in)
   L1 = save all distances to SD card
   L2 = run only the currently selected segment
   Y = stop at the end of the current segment
   DOWN = run full autonomous from segment 1
   RIGHT = run autonomous starting from the currently selected segment */
void tuningLoop() {
  // Fan position selection on Brain screen
  // Display 3 large coloured buttons
  // Defaults to position 2.
  {
    bool selected = false;
    while (!selected) {
      Brain.Screen.clearScreen();

      // Button 1 (red)
      Brain.Screen.setFillColor(color(180, 30, 30));
      Brain.Screen.drawRectangle(10, 20, 130, 180);
      Brain.Screen.setFillColor(color(220, 60, 60));
      Brain.Screen.drawRectangle(12, 22, 126, 176);
      Brain.Screen.setFillColor(color(180, 30, 30));
      Brain.Screen.setPenColor(white);
      Brain.Screen.setFont(fontType::mono40);
      Brain.Screen.setCursor(3, 2);
      Brain.Screen.print("1");

      // Button 2 (green)
      Brain.Screen.setFillColor(color(30, 130, 30));
      Brain.Screen.drawRectangle(165, 20, 130, 180);
      Brain.Screen.setFillColor(color(60, 200, 60));
      Brain.Screen.drawRectangle(167, 22, 126, 176);
      Brain.Screen.setFillColor(color(30, 130, 30));
      Brain.Screen.setPenColor(white);
      Brain.Screen.setFont(fontType::mono40);
      Brain.Screen.setCursor(3, 12);
      Brain.Screen.print("2");

      // Button 3 (blue)
      Brain.Screen.setFillColor(color(30, 30, 180));
      Brain.Screen.drawRectangle(320, 20, 130, 180);
      Brain.Screen.setFillColor(color(60, 60, 220));
      Brain.Screen.drawRectangle(322, 22, 126, 176);
      Brain.Screen.setFillColor(color(30, 30, 180));
      Brain.Screen.setPenColor(white);
      Brain.Screen.setFont(fontType::mono40);
      Brain.Screen.setCursor(3, 22);
      Brain.Screen.print("3");

      // Label row at bottom
      Brain.Screen.setFont(fontType::mono15);
      Brain.Screen.setPenColor(white);
      Brain.Screen.setFillColor(black);
      Brain.Screen.setCursor(10, 3);
      Brain.Screen.print("Fan Position 1   Fan Position 2   Fan Position 3");

      wait(20, msec);

      if (Brain.Screen.pressing()) {
        int tx = Brain.Screen.xPosition();
        int ty = Brain.Screen.yPosition();
        if (tx >= 10 && tx <= 140 && ty >= 20 && ty <= 200) {
          fanPos   = 1;
          selected = true;
          Brain.Screen.clearScreen();
          Brain.Screen.setFillColor(color(180, 30, 30));
          Brain.Screen.drawRectangle(0, 0, 480, 240);
          Brain.Screen.setPenColor(white);
          Brain.Screen.setFont(fontType::mono40);
          Brain.Screen.setCursor(4, 8);
          Brain.Screen.print("Position 1");
          wait(600, msec);
        } else if (tx >= 165 && tx <= 295 && ty >= 20 && ty <= 200) {
          fanPos   = 2;
          selected = true;
          Brain.Screen.clearScreen();
          Brain.Screen.setFillColor(color(30, 130, 30));
          Brain.Screen.drawRectangle(0, 0, 480, 240);
          Brain.Screen.setPenColor(white);
          Brain.Screen.setFont(fontType::mono40);
          Brain.Screen.setCursor(4, 8);
          Brain.Screen.print("Position 2");
          wait(600, msec);
        } else if (tx >= 320 && tx <= 450 && ty >= 20 && ty <= 200) {
          fanPos   = 3;
          selected = true;
          Brain.Screen.clearScreen();
          Brain.Screen.setFillColor(color(30, 30, 180));
          Brain.Screen.drawRectangle(0, 0, 480, 240);
          Brain.Screen.setPenColor(white);
          Brain.Screen.setFont(fontType::mono40);
          Brain.Screen.setCursor(4, 8);
          Brain.Screen.print("Position 3");
          wait(600, msec);
        }
        // Wait for finger release before continuing
        while (Brain.Screen.pressing()) wait(10, msec);
      }
    }
    Brain.Screen.clearScreen();
    Brain.Screen.setFont(fontType::mono15);
    Brain.Screen.setPenColor(white);
    Brain.Screen.setFillColor(black);
  }
  // End fan position selection

  // Outer loop: run, tune, run, tune
  while (true) {
    updateControllerDisplay();

    bool upWasPressed    = false;
    bool xWasPressed     = false;
    bool bWasPressed     = false;
    bool r1WasPressed    = false;
    bool r2WasPressed    = false;
    bool l1WasPressed    = false;
    bool l2WasPressed    = false;
    bool downWasPressed  = false;
    bool rightWasPressed = false;

    // exitMode: 0=still in loop, 1=full auton, 2=from current seg, 3=only current seg
    int exitMode = 0;

    while (exitMode == 0) {
      bool upNow = Controller1.ButtonUp.pressing();
      if (upNow && !upWasPressed) {
        currentSeg = (currentSeg + 1) % NUM_SEGMENTS;
        updateControllerDisplay();
      }
      upWasPressed = upNow;

      bool xNow = Controller1.ButtonX.pressing();
      if (xNow && !xWasPressed) {
        segDist[currentSeg] += stepSizes[stepIndex];
        segDist[currentSeg] = roundf(segDist[currentSeg] * 10.0f) / 10.0f;
        updateControllerDisplay();
      }
      xWasPressed = xNow;

      bool bNow = Controller1.ButtonB.pressing();
      if (bNow && !bWasPressed) {
        segDist[currentSeg] -= stepSizes[stepIndex];
        if (segDist[currentSeg] < 0.1f) segDist[currentSeg] = 0.1f;
        segDist[currentSeg] = roundf(segDist[currentSeg] * 10.0f) / 10.0f;
        updateControllerDisplay();
      }
      bWasPressed = bNow;

      bool r1Now = Controller1.ButtonR1.pressing();
      if (r1Now && !r1WasPressed) {
        if (currentSeg == 5) {
          seg6TurnDeg += 1.0f;
        } else if (currentSeg == 7 && fanPos == 1) {
          distDiff1 += 0.5f;
          distDiff1 = roundf(distDiff1 * 10.0f) / 10.0f;
        } else if (currentSeg == 7 && fanPos == 3) {
          distDiff3 += 0.5f;
          distDiff3 = roundf(distDiff3 * 10.0f) / 10.0f;
        } else {
          if (stepIndex < 2) stepIndex++;
        }
        updateControllerDisplay();
      }
      r1WasPressed = r1Now;

      bool r2Now = Controller1.ButtonR2.pressing();
      if (r2Now && !r2WasPressed) {
        if (currentSeg == 5) {
          if (seg6TurnDeg > 1.0f) seg6TurnDeg -= 1.0f;
        } else if (currentSeg == 7 && fanPos == 1) {
          if (distDiff1 > 0.5f) distDiff1 -= 0.5f;
          distDiff1 = roundf(distDiff1 * 10.0f) / 10.0f;
        } else if (currentSeg == 7 && fanPos == 3) {
          if (distDiff3 > 0.5f) distDiff3 -= 0.5f;
          distDiff3 = roundf(distDiff3 * 10.0f) / 10.0f;
        } else {
          if (stepIndex > 0) stepIndex--;
        }
        updateControllerDisplay();
      }
      r2WasPressed = r2Now;

      bool l1Now = Controller1.ButtonL1.pressing();
      if (l1Now && !l1WasPressed) {
        saveDistances();
        updateControllerDisplay();
      }
      l1WasPressed = l1Now;

      bool l2Now = Controller1.ButtonL2.pressing();
      if (l2Now && !l2WasPressed) {
        exitMode = 3;
      }
      l2WasPressed = l2Now;

      bool downNow = Controller1.ButtonDown.pressing();
      if (downNow && !downWasPressed) {
        exitMode = 1;
      }
      downWasPressed = downNow;

      bool rightNow = Controller1.ButtonRight.pressing();
      if (rightNow && !rightWasPressed) {
        exitMode = 2;
      }
      rightWasPressed = rightNow;

      wait(20, msec);
    }

    // Execute the chosen run
    Controller1.Screen.clearScreen();
    Controller1.Screen.setCursor(1, 1);

    if (exitMode == 1) {
      Controller1.Screen.print("Running Auton!");
      runFromSegment(0);
    } else if (exitMode == 2) {
      Controller1.Screen.print("From Seg %d...", currentSeg + 1);
      runFromSegment(currentSeg);
    } else if (exitMode == 3) {
      Controller1.Screen.print("Seg %d only...", currentSeg + 1);
      runOnlySegment(currentSeg);
    }

    // Status message before looping back to the tuning UI.
    Controller1.Screen.clearScreen();
    Controller1.Screen.setCursor(1, 1);
    if (stopAfterSeg) {
      Controller1.Screen.print("Stopped@Seg%d", currentSeg + 1);
    } else {
      Controller1.Screen.print("Done! Tuning...");
    }
    wait(800, msec);
    // Loop back to top, reinitialise debounce flags and redraw display.
  }
}
// taking the average of 2 inertials to compensate for error
int headingAveragerTask() {
  while (true) {
    float h1 = DrivetrainInertial.heading(degrees);
    float h2 = DrivetrainInertial2.heading(degrees);

    // Average with correct 0/360 wrap handling
    float diff = h2 - h1;
    while (diff >  180.0f) diff -= 360.0f;
    while (diff <= -180.0f) diff += 360.0f;
    float avg = h1 + diff * 0.5f;
    if (avg <    0.0f) avg += 360.0f;
    if (avg >= 360.0f) avg -= 360.0f;

    Drivetrain.setHeading(avg, degrees);
    wait(10, msec);
  }
  return 0;
}


int main() {
  vexcodeInit();
  vex::task headingTask = vex::task(headingAveragerTask);
  loadDistances();
  tuningLoop();
}
