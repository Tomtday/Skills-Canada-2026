  5.0,   // Seg 1 : forward
  39.0,  // Seg 2 : forward
  6.0,   // Seg 3 : forward
  58.0,  // Seg 4 : forward
  30.0,  // Seg 5 : forward
  21.0,  // Seg 6 : forward
  12.0,  // Seg 7 : forward
  41.0,  // Seg 8 : reverse
  13.0,  // Seg 9 : forward
  3.0,   // Seg 10: reverse
  16.0,  // Seg 11: forward
  5.0,   // Seg 12: reverse
  33.0,  // Seg 13: forward
  3.0,   // Seg 14: forward
  5.0    // Seg 15: forward
};

// Directions for each segment (for display only)
const char* segDir[NUM_SEGMENTS] = {
  "FWD", "FWD", "FWD", "FWD", "FWD", "FWD", "FWD",
  "REV", "FWD", "REV", "FWD", "REV", "FWD", "FWD", "FWD"
};

// Step sizes available via R1/R2: 0.5, 2.0, 5.0 inches
float stepSizes[3] = {0.5, 2.0, 5.0};
int stepIndex = 0;   // which step size is active
int currentSeg = 0;  // which segment is selected in the tuning UI
int slideDist = 550;
float seg6TurnDeg = 90.0f; // tunable turn angle for segment 6 (degrees)
float distDiff1 = 8.0f;   // extra offset for fan position 1 (inches, tunable)
float distDiff3 = 8.0f;   // extra offset for fan position 3 (inches, tunable)
int   fanPos    = 2;       // selected fan position: 1, 2, or 3


bool stopAfterSeg = false;

// Polls Y during the trailing actions of a segment (turns, spins, waits).
// Sample continuously
bool yWasPressed = false; // debounce state across polling calls

void resetYStop() {
  stopAfterSeg = false;
  yWasPressed  = Controller1.ButtonY.pressing(); // absorb any held press
}

// so the tuning loop knows where to restart.
void checkYStop(int segIndex) {
  bool yNow = Controller1.ButtonY.pressing();
  if (yNow && !yWasPressed) {
    stopAfterSeg = true;
    currentSeg   = segIndex;
  }
  yWasPressed = yNow;
}


// SD CARD: load & save
void loadDistances() {
  if (!Brain.SDcard.isInserted()) return;

  FILE* f = fopen(SD_FILENAME, "r");
  if (f == nullptr) return;

  for (int i = 0; i < NUM_SEGMENTS; i++) {
    float val = 0.0f;
    if (fscanf(f, "%f", &val) == 1 && val >= 0.1f) {
      segDist[i] = val;
    }
  }
  // Load seg6 turn degrees, keep default if missing or invalid
  float turnVal = 0.0f;
  if (fscanf(f, "%f", &turnVal) == 1 && turnVal >= 1.0f) {
    seg6TurnDeg = turnVal;
  }
  // Load distDiff1 (line 17) and distDiff3 (line 18)
  float dd1 = 0.0f, dd3 = 0.0f;
  if (fscanf(f, "%f", &dd1) == 1 && dd1 >= 0.1f) distDiff1 = dd1;
  if (fscanf(f, "%f", &dd3) == 1 && dd3 >= 0.1f) distDiff3 = dd3;
  fclose(f);
}

void saveDistances() {
  Controller1.Screen.clearScreen();
  Controller1.Screen.setCursor(1, 1);

  if (!Brain.SDcard.isInserted()) {
    Controller1.Screen.print("No SD card!");
    wait(1200, msec);
    return;
  }

  FILE* f = fopen(SD_FILENAME, "w");
  if (f == nullptr) {
    Controller1.Screen.print("Save failed!");
    wait(1200, msec);
    return;
  }

  for (int i = 0; i < NUM_SEGMENTS; i++) {
    fprintf(f, "%.2f\n", segDist[i]);
  }
  // Save seg6 turn degrees as line 16
  fprintf(f, "%.2f\n", seg6TurnDeg);
  // Save distDiff1 and distDiff3
  fprintf(f, "%.2f\n", distDiff1);
  fprintf(f, "%.2f\n", distDiff3);
  fclose(f);

  Controller1.Screen.print("Saved to SD!");
  wait(1000, msec);
}

// Controller display update 
void updateControllerDisplay() {
  Controller1.Screen.clearScreen();
  Controller1.Screen.setCursor(1, 1);
  Controller1.Screen.print("Seg %d/%d  %s", currentSeg + 1, NUM_SEGMENTS, segDir[currentSeg]);
  Controller1.Screen.setCursor(2, 1);
  Controller1.Screen.print("Dist: %.1f in", segDist[currentSeg]);
  Controller1.Screen.setCursor(3, 1);
  if (currentSeg == 5) {
    // Seg 6: R1/R2 adjust the turn angle
    Controller1.Screen.print("Turn: %.0f deg", seg6TurnDeg);
  } else if (currentSeg == 7 && fanPos == 1) {
    // Seg 8, position 1: R1/R2 adjust distDiff1
    Controller1.Screen.print("Diff1: %.1f in", distDiff1);
  } else if (currentSeg == 7 && fanPos == 3) {
    // Seg 8, position 3: R1/R2 adjust distDiff3
    Controller1.Screen.print("Diff3: %.1f in", distDiff3);
  } else {
    Controller1.Screen.print("Step: %.1f in", stepSizes[stepIndex]);
  }
}

// AUTONOMOUS ROUTINE: fall-through from startSeg to end

void runFromSegment(int startSeg) {
  Intakes.setVelocity(15.0, percent);
  Conveyor.setVelocity(40.0, percent);
  Slides.setVelocity(20.0, percent);
  Conveyor.setPosition(0.0, degrees);
  Slides.setPosition(0.0, degrees);
  Intakes.setPosition(0.0, degrees);
  Slides.setTimeout(7.0, sec);
  Drivetrain.setDriveVelocity(50.0, percent);
  resetYStop();

  switch (startSeg) {
    case 0:
    // Segment 1
    Drivetrain.driveFor(forward, segDist[0], inches, true);
    Drivetrain.turnFor(left, 90.0, degrees, true);
    checkYStop(0); if (stopAfterSeg) return;

    case 1:
    // Segment 2
    Drivetrain.driveFor(forward, segDist[1], inches, true);
    Drivetrain.turnFor(left, 90.0, degrees, true);
    checkYStop(1); if (stopAfterSeg) return;

    case 2:
{
  Drivetrain.driveFor(forward, segDist[2], inches, false);
  double start = Brain.Timer.time(msec);
  bool nudgeDone = false;
  Intakes.spin(forward);
  while (!BumperA.pressing()) {
    if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {
      Drivetrain.driveFor(forward, 1, inches, false);
      nudgeDone = true;
    }
    if ((Brain.Timer.time(msec) - start) >= 5000) {
      break;
    }
  }
  Intakes.stop();
  Slides.spinFor(forward, slideDist, degrees, true);
  Intakes.spinFor(forward, 2.0, turns, false);
  Conveyor.spinFor(forward, 6.0, turns, false);
  wait(1.0, seconds);
  Drivetrain.turnFor(right, 180.0, degrees, true);
  checkYStop(2); if (stopAfterSeg) return;
}

    case 3:
    // Segment 4 
    // drive though main hallway to the auton zone and turn into auton zone
    Drivetrain.driveFor(forward, segDist[3], inches, true);
    Drivetrain.turnFor(right, 90.0, degrees, true);
    checkYStop(3); if (stopAfterSeg) return;

    case 4:
    // Segment 5
    // drive into auton zone and make first turn in auton
    Drivetrain.driveFor(forward, segDist[4], inches, true);
    Intakes.spinToPosition(0.0, degrees, false);
    Drivetrain.turnFor(right, 90.0, degrees, true);
    checkYStop(4); if (stopAfterSeg) return;

    case 5:
    // Segment 6
    // move into main auton zone and turn to the 2nd supply
    Drivetrain.driveFor(forward, segDist[5], inches, true);
    Drivetrain.turnFor(right, seg6TurnDeg, degrees, true);
    Slides.spinFor(reverse, slideDist, degrees, true);
    //Intakes.spinFor(forward, 2.0, turns, false);
    checkYStop(5); if (stopAfterSeg) return;

    case 6:
    // Segment 7
    // intake 2nd supply
    {
  Drivetrain.driveFor(forward, segDist[6], inches, false);
  double start = Brain.Timer.time(msec);
  bool nudgeDone = false;
  Intakes.spin(forward);
  while (!BumperA.pressing()) {
    if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 5000) {
      Drivetrain.driveFor(forward, 2, inches, false);
      nudgeDone = true;
    }
    if ((Brain.Timer.time(msec) - start) >= 8000) {
      break;
    }
  }

  Intakes.stop();
  Slides.spinFor(forward, slideDist, degrees, true);
  Intakes.spinFor(forward, 2.0, turns, false);
  Conveyor.spinFor(forward, 6.0, turns, false);
  Drivetrain.turnToRotation(270, degrees, true);
    checkYStop(6); if (stopAfterSeg) return;
    }

    case 7:
    // Segment 8
    // reverse up to fan and turn to it
    {
      float seg8Rev = segDist[7];
      if      (fanPos == 1) seg8Rev -= distDiff1;
      else if (fanPos == 3) seg8Rev += distDiff3;
      Drivetrain.driveFor(reverse, seg8Rev, inches, true);
    }
    Slides.spinFor(reverse, slideDist, degrees, true);
    Drivetrain.turnFor(right, 90.0, degrees, true);
    //Intakes.spinFor(forward, 1.0, turns, false);
    checkYStop(7); if (stopAfterSeg) return;

    case 8:
    // Segment 9
    // intake fan
   {
  Drivetrain.driveFor(forward, segDist[8], inches, true);
  double start = Brain.Timer.time(msec);
  bool nudgeDone = false;
  Intakes.spin(forward);
  while (!BumperA.pressing()) {
    if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {
      Drivetrain.driveFor(forward, 1, inches, false);
      nudgeDone = true;
    }
    if ((Brain.Timer.time(msec) - start) >= 5000) {
      break;
    }
  }
    Intakes.stop();
    Slides.spinFor(forward, 12.0, turns, true);
    checkYStop(8); if (stopAfterSeg) return;
   }

    case 9:
    // Segment 10
    // reverse into platform/turn around
    Drivetrain.setDriveVelocity(25, percent);
    Drivetrain.setTurnVelocity(25, percent);
    if (fanPos == 2) {
      // Default: reverse then 180
      Drivetrain.driveFor(reverse, segDist[9], inches, true);
      Drivetrain.turnFor(right, 180.0, degrees, true);
    } else if (fanPos == 1) {
      // Position 1: turn 90 right, then drive forward by distDiff1
      Drivetrain.driveFor(reverse, segDist[9], inches, true);
      Drivetrain.turnFor(right, 90.0, degrees, true);
      Drivetrain.driveFor(forward, distDiff1, inches, true);
      Drivetrain.turnFor(right, 90.0, degrees, true);
    } else if (fanPos == 3) {
      // Position 3: turn 90 right, then reverse by distDiff3
      Drivetrain.driveFor(reverse, segDist[9], inches, true);
      Drivetrain.turnFor(right, 90.0, degrees, true);
      Drivetrain.driveFor(reverse, distDiff3, inches, true);
      Drivetrain.turnFor(right, 90.0, degrees, true);
    }
    checkYStop(9); if (stopAfterSeg) return;

    case 10:
    // Segment 11
    // outtake fan
    Drivetrain.driveFor(forward, segDist[10], inches, true);
    Intakes.spinFor(reverse, 360.0, degrees, true);
    checkYStop(10); if (stopAfterSeg) return;

    case 11:
    // Segment 12
    // reverse away after outtake
    Drivetrain.driveFor(reverse, segDist[11], inches, true);
    Drivetrain.turnFor(left, 90, degrees, true);
    Slides.spinFor(reverse, 12.0, turns, true);
    checkYStop(11); if (stopAfterSeg) return;

    case 12:
    // Segment 13
    // go to the 3rd supply
    Drivetrain.driveFor(forward, segDist[12], inches, true);
    Intakes.stop();
    checkYStop(12); if (stopAfterSeg) return;

    case 13:
    // Segment 14
    // intake 3rd supply
    {
    Drivetrain.driveFor(forward, segDist[13], inches, false);

    double start = Brain.Timer.time(msec);
    bool nudgeDone = false;
    Intakes.spin(forward);
    while (!BumperA.pressing()) {
      if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {
        Drivetrain.driveFor(forward, 1, inches, false);
        nudgeDone = true;
      }
      if ((Brain.Timer.time(msec) - start) >= 5000) {
        break;
      }
    }

    Intakes.stop();
    Drivetrain.turnFor(left, 90.0, degrees, true);
    checkYStop(13); if (stopAfterSeg) return;
    }
    case 14:
    // Segment 15
    Drivetrain.driveFor(forward, segDist[14], inches, true);
    Conveyor.spinFor(forward, 400.0, degrees, true);
    Intakes.spinFor(reverse, 8.0, turns, false);
    Conveyor.spinFor(reverse, 14.0, turns, true);
    checkYStop(14); 
    // last segment

    default:
    break;
  }
}

