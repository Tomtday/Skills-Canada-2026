{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\nbrain Brain;\n\n\n// START V5 MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END V5 MACROS\n\n\n// Robot configuration code.\ncontroller Controller1 = controller(primary);\nmotor ConveyorMotorA = motor(PORT2, ratio18_1, true);\nmotor ConveyorMotorB = motor(PORT12, ratio18_1, false);\nmotor_group Conveyor = motor_group(ConveyorMotorA, ConveyorMotorB);\n\nmotor SlidesMotorA = motor(PORT4, ratio18_1, true);\nmotor SlidesMotorB = motor(PORT5, ratio18_1, false);\nmotor_group Slides = motor_group(SlidesMotorA, SlidesMotorB);\n\nmotor IntakesMotorA = motor(PORT3, ratio18_1, false);\nmotor IntakesMotorB = motor(PORT6, ratio18_1, true);\nmotor_group Intakes = motor_group(IntakesMotorA, IntakesMotorB);\n\nmotor leftMotorA = motor(PORT8, ratio18_1, false);\nmotor leftMotorB = motor(PORT9, ratio18_1, false);\nmotor_group LeftDriveSmart = motor_group(leftMotorA, leftMotorB);\nmotor rightMotorA = motor(PORT7, ratio18_1, true);\nmotor rightMotorB = motor(PORT10, ratio18_1, true);\nmotor_group RightDriveSmart = motor_group(rightMotorA, rightMotorB);\ninertial DrivetrainInertial = inertial(PORT11);\nsmartdrive Drivetrain = smartdrive(LeftDriveSmart, RightDriveSmart, DrivetrainInertial, 200, 320, 40, mm, 1);\n\ninertial DrivetrainInertial2 = inertial(PORT1);\n\nbumper BumperA = bumper(Brain.ThreeWirePort.A);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  int systemTime = Brain.Timer.systemHighResolution();\n  double batteryCurrent = Brain.Battery.current();\n  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);\n\n  // Combine these values into a single integer\n  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;\n\n  // Set the seed\n  srand(seed);\n}\n\nbool vexcode_initial_drivetrain_calibration_completed = false;\nvoid calibrateDrivetrain() {\n  wait(200, msec);\n  Brain.Screen.print(\"Calibrating\");\n  Brain.Screen.newLine();\n  Brain.Screen.print(\"Inertial\");\n  DrivetrainInertial.calibrate();\n  while (DrivetrainInertial.isCalibrating()) {\n    wait(25, msec);\n  }\n  vexcode_initial_drivetrain_calibration_completed = true;\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n}\n\nvoid vexcodeInit() {\n\n  // Calibrate the Drivetrain\n  calibrateDrivetrain();\n\n  //Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// Helper to make playing sounds from the V5 in VEXcode easier and\n// keeps the code cleaner by making it clear what is happening.\nvoid playVexcodeSound(const char *soundName) {\n  printf(\"VEXPlaySound:%s\\n\", soundName);\n  wait(5, msec);\n}\n\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n\n#pragma endregion VEXcode Generated Robot Configuration\n#include \"vex.h\"\nusing namespace vex;\n\nfloat myVariable, drive_error, drive_sensor, drive_derivative, drive_output;\n\n\n// TUNING SYSTEM\n\n#define NUM_SEGMENTS 15\n\n#define SD_FILENAME \"segdist.txt\"\n\n// Tunable distances (inches). Defaults, overwritten by SD card on startup\nfloat segDist[NUM_SEGMENTS] = {\n  5.0,   // Seg 1 : forward\n  39.0,  // Seg 2 : forward\n  6.0,   // Seg 3 : forward\n  58.0,  // Seg 4 : forward\n  30.0,  // Seg 5 : forward\n  21.0,  // Seg 6 : forward\n  12.0,  // Seg 7 : forward\n  41.0,  // Seg 8 : reverse\n  13.0,  // Seg 9 : forward\n  3.0,   // Seg 10: reverse\n  16.0,  // Seg 11: forward\n  5.0,   // Seg 12: reverse\n  33.0,  // Seg 13: forward\n  3.0,   // Seg 14: forward\n  5.0    // Seg 15: forward\n};\n\n// Directions for each segment (for display only)\nconst char* segDir[NUM_SEGMENTS] = {\n  \"FWD\", \"FWD\", \"FWD\", \"FWD\", \"FWD\", \"FWD\", \"FWD\",\n  \"REV\", \"FWD\", \"REV\", \"FWD\", \"REV\", \"FWD\", \"FWD\", \"FWD\"\n};\n\n// Step sizes available via R1/R2: 0.5, 2.0, 5.0 inches\nfloat stepSizes[3] = {0.5, 2.0, 5.0};\nint stepIndex = 0;   // which step size is active\nint currentSeg = 0;  // which segment is selected in the tuning UI\nint slideDist = 550;\nfloat seg6TurnDeg = 90.0f; // tunable turn angle for segment 6 (degrees)\nfloat distDiff1 = 8.0f;   // extra offset for fan position 1 (inches, tunable)\nfloat distDiff3 = 8.0f;   // extra offset for fan position 3 (inches, tunable)\nint   fanPos    = 2;       // selected fan position: 1, 2, or 3\n\n\nbool stopAfterSeg = false;\n\n// Polls Y during the trailing actions of a segment (turns, spins, waits).\n// Sample continuously\nbool yWasPressed = false; // debounce state across polling calls\n\nvoid resetYStop() {\n  stopAfterSeg = false;\n  yWasPressed  = Controller1.ButtonY.pressing(); // absorb any held press\n}\n\n// so the tuning loop knows where to restart.\nvoid checkYStop(int segIndex) {\n  bool yNow = Controller1.ButtonY.pressing();\n  if (yNow && !yWasPressed) {\n    stopAfterSeg = true;\n    currentSeg   = segIndex;\n  }\n  yWasPressed = yNow;\n}\n\n\n// SD CARD: load & save\nvoid loadDistances() {\n  if (!Brain.SDcard.isInserted()) return;\n\n  FILE* f = fopen(SD_FILENAME, \"r\");\n  if (f == nullptr) return;\n\n  for (int i = 0; i < NUM_SEGMENTS; i++) {\n    float val = 0.0f;\n    if (fscanf(f, \"%f\", &val) == 1 && val >= 0.1f) {\n      segDist[i] = val;\n    }\n  }\n  // Load seg6 turn degrees, keep default if missing or invalid\n  float turnVal = 0.0f;\n  if (fscanf(f, \"%f\", &turnVal) == 1 && turnVal >= 1.0f) {\n    seg6TurnDeg = turnVal;\n  }\n  // Load distDiff1 (line 17) and distDiff3 (line 18)\n  float dd1 = 0.0f, dd3 = 0.0f;\n  if (fscanf(f, \"%f\", &dd1) == 1 && dd1 >= 0.1f) distDiff1 = dd1;\n  if (fscanf(f, \"%f\", &dd3) == 1 && dd3 >= 0.1f) distDiff3 = dd3;\n  fclose(f);\n}\n\nvoid saveDistances() {\n  Controller1.Screen.clearScreen();\n  Controller1.Screen.setCursor(1, 1);\n\n  if (!Brain.SDcard.isInserted()) {\n    Controller1.Screen.print(\"No SD card!\");\n    wait(1200, msec);\n    return;\n  }\n\n  FILE* f = fopen(SD_FILENAME, \"w\");\n  if (f == nullptr) {\n    Controller1.Screen.print(\"Save failed!\");\n    wait(1200, msec);\n    return;\n  }\n\n  for (int i = 0; i < NUM_SEGMENTS; i++) {\n    fprintf(f, \"%.2f\\n\", segDist[i]);\n  }\n  // Save seg6 turn degrees as line 16\n  fprintf(f, \"%.2f\\n\", seg6TurnDeg);\n  // Save distDiff1 and distDiff3\n  fprintf(f, \"%.2f\\n\", distDiff1);\n  fprintf(f, \"%.2f\\n\", distDiff3);\n  fclose(f);\n\n  Controller1.Screen.print(\"Saved to SD!\");\n  wait(1000, msec);\n}\n\n// Controller display update \nvoid updateControllerDisplay() {\n  Controller1.Screen.clearScreen();\n  Controller1.Screen.setCursor(1, 1);\n  Controller1.Screen.print(\"Seg %d/%d  %s\", currentSeg + 1, NUM_SEGMENTS, segDir[currentSeg]);\n  Controller1.Screen.setCursor(2, 1);\n  Controller1.Screen.print(\"Dist: %.1f in\", segDist[currentSeg]);\n  Controller1.Screen.setCursor(3, 1);\n  if (currentSeg == 5) {\n    // Seg 6: R1/R2 adjust the turn angle\n    Controller1.Screen.print(\"Turn: %.0f deg\", seg6TurnDeg);\n  } else if (currentSeg == 7 && fanPos == 1) {\n    // Seg 8, position 1: R1/R2 adjust distDiff1\n    Controller1.Screen.print(\"Diff1: %.1f in\", distDiff1);\n  } else if (currentSeg == 7 && fanPos == 3) {\n    // Seg 8, position 3: R1/R2 adjust distDiff3\n    Controller1.Screen.print(\"Diff3: %.1f in\", distDiff3);\n  } else {\n    Controller1.Screen.print(\"Step: %.1f in\", stepSizes[stepIndex]);\n  }\n}\n\n// AUTONOMOUS ROUTINE: fall-through from startSeg to end\n\nvoid runFromSegment(int startSeg) {\n  Intakes.setVelocity(15.0, percent);\n  Conveyor.setVelocity(40.0, percent);\n  Slides.setVelocity(20.0, percent);\n  Conveyor.setPosition(0.0, degrees);\n  Slides.setPosition(0.0, degrees);\n  Intakes.setPosition(0.0, degrees);\n  Slides.setTimeout(7.0, sec);\n  Drivetrain.setDriveVelocity(50.0, percent);\n  resetYStop();\n\n  switch (startSeg) {\n    case 0:\n    // Segment 1\n    Drivetrain.driveFor(forward, segDist[0], inches, true);\n    Drivetrain.turnFor(left, 90.0, degrees, true);\n    checkYStop(0); if (stopAfterSeg) return;\n\n    case 1:\n    // Segment 2\n    Drivetrain.driveFor(forward, segDist[1], inches, true);\n    Drivetrain.turnFor(left, 90.0, degrees, true);\n    checkYStop(1); if (stopAfterSeg) return;\n\n    case 2:\n{\n  Drivetrain.driveFor(forward, segDist[2], inches, false);\n  double start = Brain.Timer.time(msec);\n  bool nudgeDone = false;\n  Intakes.spin(forward);\n  while (!BumperA.pressing()) {\n    if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {\n      Drivetrain.driveFor(forward, 1, inches, false);\n      nudgeDone = true;\n    }\n    if ((Brain.Timer.time(msec) - start) >= 5000) {\n      break;\n    }\n  }\n  Intakes.stop();\n  Slides.spinFor(forward, slideDist, degrees, true);\n  Intakes.spinFor(forward, 2.0, turns, false);\n  Conveyor.spinFor(forward, 6.0, turns, false);\n  wait(1.0, seconds);\n  Drivetrain.turnFor(right, 180.0, degrees, true);\n  checkYStop(2); if (stopAfterSeg) return;\n}\n\n    case 3:\n    // Segment 4 \n    // drive though main hallway to the auton zone and turn into auton zone\n    Drivetrain.driveFor(forward, segDist[3], inches, true);\n    Drivetrain.turnFor(right, 90.0, degrees, true);\n    checkYStop(3); if (stopAfterSeg) return;\n\n    case 4:\n    // Segment 5\n    // drive into auton zone and make first turn in auton\n    Drivetrain.driveFor(forward, segDist[4], inches, true);\n    Intakes.spinToPosition(0.0, degrees, false);\n    Drivetrain.turnFor(right, 90.0, degrees, true);\n    checkYStop(4); if (stopAfterSeg) return;\n\n    case 5:\n    // Segment 6\n    // move into main auton zone and turn to the 2nd supply\n    Drivetrain.driveFor(forward, segDist[5], inches, true);\n    Drivetrain.turnFor(right, seg6TurnDeg, degrees, true);\n    Slides.spinFor(reverse, slideDist, degrees, true);\n    //Intakes.spinFor(forward, 2.0, turns, false);\n    checkYStop(5); if (stopAfterSeg) return;\n\n    case 6:\n    // Segment 7\n    // intake 2nd supply\n    {\n  Drivetrain.driveFor(forward, segDist[6], inches, false);\n  double start = Brain.Timer.time(msec);\n  bool nudgeDone = false;\n  Intakes.spin(forward);\n  while (!BumperA.pressing()) {\n    if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 5000) {\n      Drivetrain.driveFor(forward, 2, inches, false);\n      nudgeDone = true;\n    }\n    if ((Brain.Timer.time(msec) - start) >= 8000) {\n      break;\n    }\n  }\n\n  Intakes.stop();\n  Slides.spinFor(forward, slideDist, degrees, true);\n  Intakes.spinFor(forward, 2.0, turns, false);\n  Conveyor.spinFor(forward, 6.0, turns, false);\n  Drivetrain.turnToRotation(270, degrees, true);\n    checkYStop(6); if (stopAfterSeg) return;\n    }\n\n    case 7:\n    // Segment 8\n    // reverse up to fan and turn to it\n    {\n      float seg8Rev = segDist[7];\n      if      (fanPos == 1) seg8Rev -= distDiff1;\n      else if (fanPos == 3) seg8Rev += distDiff3;\n      Drivetrain.driveFor(reverse, seg8Rev, inches, true);\n    }\n    Slides.spinFor(reverse, slideDist, degrees, true);\n    Drivetrain.turnFor(right, 90.0, degrees, true);\n    //Intakes.spinFor(forward, 1.0, turns, false);\n    checkYStop(7); if (stopAfterSeg) return;\n\n    case 8:\n    // Segment 9\n    // intake fan\n   {\n  Drivetrain.driveFor(forward, segDist[8], inches, true);\n  double start = Brain.Timer.time(msec);\n  bool nudgeDone = false;\n  Intakes.spin(forward);\n  while (!BumperA.pressing()) {\n    if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {\n      Drivetrain.driveFor(forward, 1, inches, false);\n      nudgeDone = true;\n    }\n    if ((Brain.Timer.time(msec) - start) >= 5000) {\n      break;\n    }\n  }\n    Intakes.stop();\n    Slides.spinFor(forward, 12.0, turns, true);\n    checkYStop(8); if (stopAfterSeg) return;\n   }\n\n    case 9:\n    // Segment 10\n    // reverse into platform/turn around\n    Drivetrain.setDriveVelocity(25, percent);\n    Drivetrain.setTurnVelocity(25, percent);\n    if (fanPos == 2) {\n      // Default: reverse then 180\n      Drivetrain.driveFor(reverse, segDist[9], inches, true);\n      Drivetrain.turnFor(right, 180.0, degrees, true);\n    } else if (fanPos == 1) {\n      // Position 1: turn 90 right, then drive forward by distDiff1\n      Drivetrain.driveFor(reverse, segDist[9], inches, true);\n      Drivetrain.turnFor(right, 90.0, degrees, true);\n      Drivetrain.driveFor(forward, distDiff1, inches, true);\n      Drivetrain.turnFor(right, 90.0, degrees, true);\n    } else if (fanPos == 3) {\n      // Position 3: turn 90 right, then reverse by distDiff3\n      Drivetrain.driveFor(reverse, segDist[9], inches, true);\n      Drivetrain.turnFor(right, 90.0, degrees, true);\n      Drivetrain.driveFor(reverse, distDiff3, inches, true);\n      Drivetrain.turnFor(right, 90.0, degrees, true);\n    }\n    checkYStop(9); if (stopAfterSeg) return;\n\n    case 10:\n    // Segment 11\n    // outtake fan\n    Drivetrain.driveFor(forward, segDist[10], inches, true);\n    Intakes.spinFor(reverse, 360.0, degrees, true);\n    checkYStop(10); if (stopAfterSeg) return;\n\n    case 11:\n    // Segment 12\n    // reverse away after outtake\n    Drivetrain.driveFor(reverse, segDist[11], inches, true);\n    Drivetrain.turnFor(left, 90, degrees, true);\n    Slides.spinFor(reverse, 12.0, turns, true);\n    checkYStop(11); if (stopAfterSeg) return;\n\n    case 12:\n    // Segment 13\n    // go to the 3rd supply\n    Drivetrain.driveFor(forward, segDist[12], inches, true);\n    Intakes.stop();\n    checkYStop(12); if (stopAfterSeg) return;\n\n    case 13:\n    // Segment 14\n    // intake 3rd supply\n    {\n    Drivetrain.driveFor(forward, segDist[13], inches, false);\n\n    double start = Brain.Timer.time(msec);\n    bool nudgeDone = false;\n    Intakes.spin(forward);\n    while (!BumperA.pressing()) {\n      if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {\n        Drivetrain.driveFor(forward, 1, inches, false);\n        nudgeDone = true;\n      }\n      if ((Brain.Timer.time(msec) - start) >= 5000) {\n        break;\n      }\n    }\n\n    Intakes.stop();\n    Drivetrain.turnFor(left, 90.0, degrees, true);\n    checkYStop(13); if (stopAfterSeg) return;\n    }\n    case 14:\n    // Segment 15\n    Drivetrain.driveFor(forward, segDist[14], inches, true);\n    Conveyor.spinFor(forward, 400.0, degrees, true);\n    Intakes.spinFor(reverse, 8.0, turns, false);\n    Conveyor.spinFor(reverse, 14.0, turns, true);\n    checkYStop(14); \n    // last segment\n\n    default:\n    break;\n  }\n}\n\n// runOnlySegment: executes exactly one segment then stops\nvoid runOnlySegment(int seg) {\n  Intakes.setVelocity(15.0, percent);\n  Conveyor.setVelocity(40.0, percent);\n  Slides.setVelocity(20.0, percent);\n  Conveyor.setPosition(0.0, degrees);\n  Slides.setPosition(0.0, degrees);\n  Intakes.setPosition(0.0, degrees);\n  Slides.setTimeout(4.0, sec);\n  Drivetrain.setDriveVelocity(50.0, percent);\n  resetYStop();\n\n  switch (seg) {\n    case 0:\n    // Segment 1\n    Drivetrain.driveFor(forward, segDist[0], inches, true);\n    Drivetrain.turnFor(left, 90.0, degrees, true);\n    checkYStop(0); if (stopAfterSeg) return;\n\n    case 1:\n    // Segment 2\n    Drivetrain.driveFor(forward, segDist[1], inches, true);\n    Drivetrain.turnFor(left, 90.0, degrees, true);\n    checkYStop(1); if (stopAfterSeg) return;\n\n    case 2:\n{\n  Drivetrain.driveFor(forward, segDist[2], inches, false);\n  double start = Brain.Timer.time(msec);\n  bool nudgeDone = false;\n  Intakes.spin(forward);\n  while (!BumperA.pressing()) {\n    if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {\n      Drivetrain.driveFor(forward, 1, inches, false);\n      nudgeDone = true;\n    }\n    if ((Brain.Timer.time(msec) - start) >= 5000) {\n      break;\n    }\n  }\n  Intakes.stop();\n  Slides.spinFor(forward, slideDist, degrees, true);\n  Intakes.spinFor(forward, 2.0, turns, false);\n  Conveyor.spinFor(forward, 6.0, turns, false);\n  wait(1.0, seconds);\n  Drivetrain.turnFor(right, 180.0, degrees, true);\n  checkYStop(2); if (stopAfterSeg) return;\n}\n\n    case 3:\n    // Segment 4\n    // drive though main hallway to the auton zone and turn into auton zone\n    Drivetrain.driveFor(forward, segDist[3], inches, true);\n    Drivetrain.turnFor(right, 90.0, degrees, true);\n    checkYStop(3); if (stopAfterSeg) return;\n\n    case 4:\n    // Segment 5\n    // drive into auton zone and make first turn in auton\n    Drivetrain.driveFor(forward, segDist[4], inches, true);\n    Intakes.spinToPosition(0.0, degrees, false);\n    Drivetrain.turnFor(right, 90.0, degrees, true);\n    checkYStop(4); if (stopAfterSeg) return;\n\n    case 5:\n    // Segment 6\n    // move into main auton zone and turn to the 2nd supply\n    Drivetrain.driveFor(forward, segDist[5], inches, true);\n    Drivetrain.turnFor(right, seg6TurnDeg, degrees, true);\n    Slides.spinFor(reverse, slideDist, degrees, true);\n    //Intakes.spinFor(forward, 2.0, turns, false);\n    checkYStop(5); if (stopAfterSeg) return;\n\n    case 6:\n    // Segment 7\n    // intake 2nd supply\n    {\n  Drivetrain.driveFor(forward, segDist[6], inches, true);\n  double start = Brain.Timer.time(msec);\n  bool nudgeDone = false;\n  Intakes.spin(forward);\n  while (!BumperA.pressing()) {\n    if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {\n      Drivetrain.driveFor(forward, 1, inches, false);\n      nudgeDone = true;\n    }\n    if ((Brain.Timer.time(msec) - start) >= 5000) {\n      break;\n    }\n  }\n  Intakes.stop();\n  Slides.spinFor(forward, slideDist, degrees, true);\n  Intakes.spinFor(forward, 2.0, turns, false);\n  Conveyor.spinFor(forward, 6.0, turns, false);\n  Drivetrain.turnToRotation(270, degrees, true);\n    checkYStop(6); if (stopAfterSeg) return;\n    }\n\n    case 7:\n    // Segment 8\n    // reverse up to fan and turn to it\n    {\n      float seg8Rev = segDist[7];\n      if      (fanPos == 1) seg8Rev -= distDiff1;\n      else if (fanPos == 3) seg8Rev += distDiff3;\n      Drivetrain.driveFor(reverse, seg8Rev, inches, true);\n    }\n    Slides.spinFor(reverse, slideDist, degrees, true);\n    Drivetrain.turnFor(right, 90.0, degrees, true);\n    //Intakes.spinFor(forward, 1.0, turns, false);\n    checkYStop(7); if (stopAfterSeg) return;\n\n    case 8:\n    // Segment 9\n    // intake fan\n   {\n  Drivetrain.driveFor(forward, segDist[8], inches, true);\n  double start = Brain.Timer.time(msec);\n  bool nudgeDone = false;\n  Intakes.spin(forward);\n  while (!BumperA.pressing()) {\n    if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {\n      Drivetrain.driveFor(forward, 1, inches, false);\n      nudgeDone = true;\n    }\n    if ((Brain.Timer.time(msec) - start) >= 5000) {\n      break;\n    }\n  }\n    Intakes.stop();\n    //Intakes.spinFor(reverse, 20.0, degrees, true);\n    Slides.spinFor(forward, 12, turns, true);\n    checkYStop(8); if (stopAfterSeg) return;\n   }\n\n    case 9:\n    // Segment 10\n    // reverse into platform/turn around\n    Drivetrain.setDriveVelocity(30, percent);\n    Drivetrain.setTurnVelocity(30, percent);\n    if (fanPos == 2) {\n      // Default: reverse then 180\n      Drivetrain.driveFor(reverse, segDist[9], inches, true);\n      Drivetrain.turnFor(right, 180.0, degrees, true);\n    } else if (fanPos == 1) {\n      // Position 1: turn 90 right, then drive forward by distDiff1\n      Drivetrain.turnFor(right, 90.0, degrees, true);\n      Drivetrain.driveFor(forward, distDiff1, inches, true);\n    } else if (fanPos == 3) {\n      // Position 3: turn 90 right, then reverse by distDiff3\n      Drivetrain.turnFor(right, 90.0, degrees, true);\n      Drivetrain.driveFor(reverse, distDiff3, inches, true);\n    }\n    checkYStop(9); if (stopAfterSeg) return;\n\n    case 10:\n    // Segment 11\n    // outtake fan\n    Drivetrain.driveFor(forward, segDist[10], inches, true);\n    Intakes.spinFor(reverse, 360.0, degrees, true);\n    checkYStop(10); if (stopAfterSeg) return;\n\n    case 11:\n    // Segment 12\n    // reverse away after outtake\n    Drivetrain.driveFor(reverse, segDist[11], inches, true);\n    Drivetrain.turnFor(left, 90, degrees, true);\n    Slides.spinFor(reverse, 12.0, turns, true);\n    checkYStop(11); if (stopAfterSeg) return;\n\n    case 12:\n    // Segment 13\n    // go to the 3rd supply\n    Drivetrain.driveFor(forward, segDist[12], inches, true);\n    Intakes.stop();\n    checkYStop(12); if (stopAfterSeg) return;\n\n    case 13:\n    // Segment 14\n    // intake 3rd supply\n    {\n    Drivetrain.driveFor(forward, segDist[13], inches, false);\n\n    double start = Brain.Timer.time(msec);\n    bool nudgeDone = false;\n    Intakes.spin(forward);\n    while (!BumperA.pressing()) {\n      if (!nudgeDone && (Brain.Timer.time(msec) - start) >= 2000) {\n        Drivetrain.driveFor(forward, 1, inches, false);\n        nudgeDone = true;\n      }\n      if ((Brain.Timer.time(msec) - start) >= 5000) {\n        break;\n      }\n    }\n    Intakes.stop();\n    Drivetrain.turnFor(left, 90.0, degrees, true);\n    checkYStop(13); if (stopAfterSeg) return;\n    }\n    case 14:\n    // Segment 15\n    Drivetrain.driveFor(forward, segDist[14], inches, true);\n    Slides.spinToPosition(slideDist, degrees, true);\n    Intakes.spinToPosition (60, degrees, true);\n    Conveyor.spinFor(forward, 6.7, turns, true);\n    Intakes.spinFor(reverse, 30, degrees, true);\n    Intakes.spinToPosition(60, degrees, true);\n    Conveyor.spinFor(reverse, 400, degrees, true);\n    Intakes.spinFor(reverse, 30, degrees);\n    checkYStop(14);\n    // last segmen\n\n    default:\n    break;\n  }\n}\n\n// Tuning loop:\n/*\n Controls:\n   UP = advance to next segment (wraps around)\n   X = increase current segment distance by step\n   B = decrease current segment distance by step (min 0.1 in)\n   R1 = increase step size (0.5, 2.0, 5.0 in)\n   R2 = decrease step size (5.0, 2.0, 0.5 in)\n   L1 = save all distances to SD card\n   L2 = run only the currently selected segment\n   Y = stop at the end of the current segment\n   DOWN = run full autonomous from segment 1\n   RIGHT = run autonomous starting from the currently selected segment */\nvoid tuningLoop() {\n  // Fan position selection on Brain screen\n  // Display 3 large coloured buttons\n  // Defaults to position 2.\n  {\n    bool selected = false;\n    while (!selected) {\n      Brain.Screen.clearScreen();\n\n      // Button 1 (red)\n      Brain.Screen.setFillColor(color(180, 30, 30));\n      Brain.Screen.drawRectangle(10, 20, 130, 180);\n      Brain.Screen.setFillColor(color(220, 60, 60));\n      Brain.Screen.drawRectangle(12, 22, 126, 176);\n      Brain.Screen.setFillColor(color(180, 30, 30));\n      Brain.Screen.setPenColor(white);\n      Brain.Screen.setFont(fontType::mono40);\n      Brain.Screen.setCursor(3, 2);\n      Brain.Screen.print(\"1\");\n\n      // Button 2 (green)\n      Brain.Screen.setFillColor(color(30, 130, 30));\n      Brain.Screen.drawRectangle(165, 20, 130, 180);\n      Brain.Screen.setFillColor(color(60, 200, 60));\n      Brain.Screen.drawRectangle(167, 22, 126, 176);\n      Brain.Screen.setFillColor(color(30, 130, 30));\n      Brain.Screen.setPenColor(white);\n      Brain.Screen.setFont(fontType::mono40);\n      Brain.Screen.setCursor(3, 12);\n      Brain.Screen.print(\"2\");\n\n      // Button 3 (blue)\n      Brain.Screen.setFillColor(color(30, 30, 180));\n      Brain.Screen.drawRectangle(320, 20, 130, 180);\n      Brain.Screen.setFillColor(color(60, 60, 220));\n      Brain.Screen.drawRectangle(322, 22, 126, 176);\n      Brain.Screen.setFillColor(color(30, 30, 180));\n      Brain.Screen.setPenColor(white);\n      Brain.Screen.setFont(fontType::mono40);\n      Brain.Screen.setCursor(3, 22);\n      Brain.Screen.print(\"3\");\n\n      // Label row at bottom\n      Brain.Screen.setFont(fontType::mono15);\n      Brain.Screen.setPenColor(white);\n      Brain.Screen.setFillColor(black);\n      Brain.Screen.setCursor(10, 3);\n      Brain.Screen.print(\"Fan Position 1   Fan Position 2   Fan Position 3\");\n\n      wait(20, msec);\n\n      if (Brain.Screen.pressing()) {\n        int tx = Brain.Screen.xPosition();\n        int ty = Brain.Screen.yPosition();\n        if (tx >= 10 && tx <= 140 && ty >= 20 && ty <= 200) {\n          fanPos   = 1;\n          selected = true;\n          Brain.Screen.clearScreen();\n          Brain.Screen.setFillColor(color(180, 30, 30));\n          Brain.Screen.drawRectangle(0, 0, 480, 240);\n          Brain.Screen.setPenColor(white);\n          Brain.Screen.setFont(fontType::mono40);\n          Brain.Screen.setCursor(4, 8);\n          Brain.Screen.print(\"Position 1\");\n          wait(600, msec);\n        } else if (tx >= 165 && tx <= 295 && ty >= 20 && ty <= 200) {\n          fanPos   = 2;\n          selected = true;\n          Brain.Screen.clearScreen();\n          Brain.Screen.setFillColor(color(30, 130, 30));\n          Brain.Screen.drawRectangle(0, 0, 480, 240);\n          Brain.Screen.setPenColor(white);\n          Brain.Screen.setFont(fontType::mono40);\n          Brain.Screen.setCursor(4, 8);\n          Brain.Screen.print(\"Position 2\");\n          wait(600, msec);\n        } else if (tx >= 320 && tx <= 450 && ty >= 20 && ty <= 200) {\n          fanPos   = 3;\n          selected = true;\n          Brain.Screen.clearScreen();\n          Brain.Screen.setFillColor(color(30, 30, 180));\n          Brain.Screen.drawRectangle(0, 0, 480, 240);\n          Brain.Screen.setPenColor(white);\n          Brain.Screen.setFont(fontType::mono40);\n          Brain.Screen.setCursor(4, 8);\n          Brain.Screen.print(\"Position 3\");\n          wait(600, msec);\n        }\n        // Wait for finger release before continuing\n        while (Brain.Screen.pressing()) wait(10, msec);\n      }\n    }\n    Brain.Screen.clearScreen();\n    Brain.Screen.setFont(fontType::mono15);\n    Brain.Screen.setPenColor(white);\n    Brain.Screen.setFillColor(black);\n  }\n  // End fan position selection\n\n  // Outer loop: run, tune, run, tune\n  while (true) {\n    updateControllerDisplay();\n\n    bool upWasPressed    = false;\n    bool xWasPressed     = false;\n    bool bWasPressed     = false;\n    bool r1WasPressed    = false;\n    bool r2WasPressed    = false;\n    bool l1WasPressed    = false;\n    bool l2WasPressed    = false;\n    bool downWasPressed  = false;\n    bool rightWasPressed = false;\n\n    // exitMode: 0=still in loop, 1=full auton, 2=from current seg, 3=only current seg\n    int exitMode = 0;\n\n    while (exitMode == 0) {\n      bool upNow = Controller1.ButtonUp.pressing();\n      if (upNow && !upWasPressed) {\n        currentSeg = (currentSeg + 1) % NUM_SEGMENTS;\n        updateControllerDisplay();\n      }\n      upWasPressed = upNow;\n\n      bool xNow = Controller1.ButtonX.pressing();\n      if (xNow && !xWasPressed) {\n        segDist[currentSeg] += stepSizes[stepIndex];\n        segDist[currentSeg] = roundf(segDist[currentSeg] * 10.0f) / 10.0f;\n        updateControllerDisplay();\n      }\n      xWasPressed = xNow;\n\n      bool bNow = Controller1.ButtonB.pressing();\n      if (bNow && !bWasPressed) {\n        segDist[currentSeg] -= stepSizes[stepIndex];\n        if (segDist[currentSeg] < 0.1f) segDist[currentSeg] = 0.1f;\n        segDist[currentSeg] = roundf(segDist[currentSeg] * 10.0f) / 10.0f;\n        updateControllerDisplay();\n      }\n      bWasPressed = bNow;\n\n      bool r1Now = Controller1.ButtonR1.pressing();\n      if (r1Now && !r1WasPressed) {\n        if (currentSeg == 5) {\n          seg6TurnDeg += 1.0f;\n        } else if (currentSeg == 7 && fanPos == 1) {\n          distDiff1 += 0.5f;\n          distDiff1 = roundf(distDiff1 * 10.0f) / 10.0f;\n        } else if (currentSeg == 7 && fanPos == 3) {\n          distDiff3 += 0.5f;\n          distDiff3 = roundf(distDiff3 * 10.0f) / 10.0f;\n        } else {\n          if (stepIndex < 2) stepIndex++;\n        }\n        updateControllerDisplay();\n      }\n      r1WasPressed = r1Now;\n\n      bool r2Now = Controller1.ButtonR2.pressing();\n      if (r2Now && !r2WasPressed) {\n        if (currentSeg == 5) {\n          if (seg6TurnDeg > 1.0f) seg6TurnDeg -= 1.0f;\n        } else if (currentSeg == 7 && fanPos == 1) {\n          if (distDiff1 > 0.5f) distDiff1 -= 0.5f;\n          distDiff1 = roundf(distDiff1 * 10.0f) / 10.0f;\n        } else if (currentSeg == 7 && fanPos == 3) {\n          if (distDiff3 > 0.5f) distDiff3 -= 0.5f;\n          distDiff3 = roundf(distDiff3 * 10.0f) / 10.0f;\n        } else {\n          if (stepIndex > 0) stepIndex--;\n        }\n        updateControllerDisplay();\n      }\n      r2WasPressed = r2Now;\n\n      bool l1Now = Controller1.ButtonL1.pressing();\n      if (l1Now && !l1WasPressed) {\n        saveDistances();\n        updateControllerDisplay();\n      }\n      l1WasPressed = l1Now;\n\n      bool l2Now = Controller1.ButtonL2.pressing();\n      if (l2Now && !l2WasPressed) {\n        exitMode = 3;\n      }\n      l2WasPressed = l2Now;\n\n      bool downNow = Controller1.ButtonDown.pressing();\n      if (downNow && !downWasPressed) {\n        exitMode = 1;\n      }\n      downWasPressed = downNow;\n\n      bool rightNow = Controller1.ButtonRight.pressing();\n      if (rightNow && !rightWasPressed) {\n        exitMode = 2;\n      }\n      rightWasPressed = rightNow;\n\n      wait(20, msec);\n    }\n\n    // Execute the chosen run\n    Controller1.Screen.clearScreen();\n    Controller1.Screen.setCursor(1, 1);\n\n    if (exitMode == 1) {\n      Controller1.Screen.print(\"Running Auton!\");\n      runFromSegment(0);\n    } else if (exitMode == 2) {\n      Controller1.Screen.print(\"From Seg %d...\", currentSeg + 1);\n      runFromSegment(currentSeg);\n    } else if (exitMode == 3) {\n      Controller1.Screen.print(\"Seg %d only...\", currentSeg + 1);\n      runOnlySegment(currentSeg);\n    }\n\n    // Status message before looping back to the tuning UI.\n    Controller1.Screen.clearScreen();\n    Controller1.Screen.setCursor(1, 1);\n    if (stopAfterSeg) {\n      Controller1.Screen.print(\"Stopped@Seg%d\", currentSeg + 1);\n    } else {\n      Controller1.Screen.print(\"Done! Tuning...\");\n    }\n    wait(800, msec);\n    // Loop back to top, reinitialise debounce flags and redraw display.\n  }\n}\n// taking the average of 2 inertials to compensate for error\nint headingAveragerTask() {\n  while (true) {\n    float h1 = DrivetrainInertial.heading(degrees);\n    float h2 = DrivetrainInertial2.heading(degrees);\n\n    // Average with correct 0/360 wrap handling\n    float diff = h2 - h1;\n    while (diff >  180.0f) diff -= 360.0f;\n    while (diff <= -180.0f) diff += 360.0f;\n    float avg = h1 + diff * 0.5f;\n    if (avg <    0.0f) avg += 360.0f;\n    if (avg >= 360.0f) avg -= 360.0f;\n\n    Drivetrain.setHeading(avg, degrees);\n    wait(10, msec);\n  }\n  return 0;\n}\n\n\nint main() {\n  vexcodeInit();\n  vex::task headingTask = vex::task(headingAveragerTask);\n  loadDistances();\n  tuningLoop();\n}\n","textLanguage":"cpp","robotConfig":[{"port":[],"name":"Controller1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[2,12],"name":"Conveyor","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[4,5],"name":"Slides","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[3,6],"name":"Intakes","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"false","motor_b_reversed":"true"},"triportSourcePort":22},{"port":[8,9,7,10,11],"name":"Drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"4-motor","wheelSize":"wheel200mm","gear":"ratio18_1","gearRatio":"1:1","direction":"fwd","gyroType":"inertial","width":"295","unit":"mm","wheelbase":"40","wheelbaseUnit":"mm","xOffset":"0","xOffsetUnit":"mm","yOffset":"0","yOffsetUnit":"mm","thetaOffset":"180"},"triportSourcePort":null},{"port":[1],"name":"DrivetrainInertial2","customName":true,"deviceType":"Inertial","deviceClass":"inertial","setting":{},"triportSourcePort":null},{"port":[1],"name":"BumperA","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{"id":"partner"},"triportSourcePort":22}],"slot":2,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}